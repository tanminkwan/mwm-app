# docker compose 가 읽는 설정 템플릿 (TASK 1-4).
#   cp .env.example .env    → '필수' 칸을 채운다 → ./init_certs.sh → docker compose up -d
# 여기에 없는 키는 compose 가 컨테이너로 넘기지 않는다 — .env 에 적어도 효과가 없다.
# 값에 작은따옴표가 있으면 큰따옴표로 감싼다.
# 무작위 값 만들기:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# =============================================================================
# 필수 — 비어 있으면 docker compose 가 변수명을 출력하고 멈추거나, 앱이 기동하지 않는다
# =============================================================================

# DB 데이터 디렉터리 (호스트 경로). 기본값이 없다 — 빠뜨려서 빈 DB 로 뜨는 것을 막는다
MWM_DB_DATA_DIR=./volumes/db

# 세션·JWT 서명 키. 32바이트 이상, 배포마다 새로 만든다.
# 바꾸면 모든 로그인 세션·Agent 토큰·개인 토큰이 무효가 된다.
MWM_SECRET_KEY=

# DB 비밀번호
#   POSTGRES_PASSWORD : postgres superuser. 빈 볼륨 최초 초기화 때만 쓰인다
#   MWM_DB_PASSWORD   : 앱 계정 비밀번호. mwm-app·mwm-idp 접속 + 최초 초기화
POSTGRES_PASSWORD=
MWM_DB_PASSWORD=

# IDP
#   IDP_SECRET_KEY    : IDP 서버의 세션 서명 키
#   IDP_CLIENT_SECRET : 앱 ↔ IDP 클라이언트 비밀. IDP(IDP_MWM_CLIENT_SECRET)와 앱이 이 한 값을 함께 쓴다
IDP_SECRET_KEY=
IDP_CLIENT_SECRET=

# 앱이 쓰는 MinIO 액세스 키
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# 선택 — 비우면 해당 기능만 동작하지 않는다
# =============================================================================

# DB 앱 계정 이름 (기본 mwm). 이미 다른 이름의 계정으로 운영 중인 DB 면 그 이름을 넣는다
#MWM_DB_USER=mwm

# 번들 MinIO(개발용). 운영 MinIO 는 별도다
#   MWM_MINIO_DATA_DIR       : 데이터 디렉터리 (기본 ./volumes/minio)
#   MINIO_OIDC_CLIENT_SECRET : 번들 MinIO 콘솔의 IDP 로그인용
#MWM_MINIO_DATA_DIR=./volumes/minio
MINIO_OIDC_CLIENT_SECRET=

# 이 스택 밖의 외부 서비스 주소. 지정하지 않으면 동작하지 않는 예시 도메인이 들어간다
#   PLANTUML_URL     : 지식관리 화면의 PlantUML 렌더링 서버 (브라우저가 <URL>/png/... 로 접근)
#   NOTIFICATION_URL : WAS 상태 비정상 알림을 POST 로 보내는 엔드포인트 (배치 job)
#PLANTUML_URL=https://plantuml.example.com:20443
#NOTIFICATION_URL=https://monitor.example.com:20443/notification
# 알림 서버의 TLS 인증서 검증. true(기본) / false / CA 번들 파일 경로 (사설 인증서일 때 — 컨테이너에 마운트한 경로)
#NOTIFICATION_VERIFY=true

# 로그 레벨 (기본 INFO), API 오류 응답의 스택트레이스 (기본 False — 개발 때만 True)
#LOGGING_LEVEL=INFO
#FAB_API_SHOW_STACKTRACE=False

# 메일 발송. 비우면 메일 발송만 실패한다.
#   Gmail 이면 계정 비밀번호가 아니라 '앱 비밀번호'를 쓴다.
#   SMTP_HOST / SMTP_PORT : 메일 서버 (기본 smtp.gmail.com:587)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# MQTT 실시간 Command 발송. 기본 False(opt-in) — 쓰려면 True 로 명시한다.
# False 이면 paho import/접속/스레드/발행을 일절 하지 않고 REST 폴링만 동작한다.
MQTT_ENABLED=False
# 컨트롤러 계정. ACL 은 'topic write cmd/#' (발행 전용)
MQTT_USERNAME=central
MQTT_PASSWORD=
# MQTT_BROKER_HOST/PORT 는 보통 지정하지 않는다.
#   컨테이너: docker-compose.yml 기본값 mqtt-broker.local (extra_hosts 의 host-gateway 매핑)
#   여기에 localhost 를 쓰면 컨테이너에도 localhost 가 주입되어 접속 실패한다.
#MQTT_BROKER_HOST=
#MQTT_BROKER_PORT=1883

# -----------------------------------------------------------------------------
# 참고 — compose 가 컨테이너로 넘기지 않는 값 (호스트에서 앱을 직접 실행할 때만 효과가 있다)
#   MQTT_CLIENT_ID_PREFIX=controller   client_id = controller-{hostname}-{pid}
#   MQTT_RECONNECT_DELAY=60            재접속 재시도 주기(초)
#   MQTT_LOG_THROTTLE_SECONDS=3600     연결성 로그 억제 창(초)
# -----------------------------------------------------------------------------
