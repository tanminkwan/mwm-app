# flake8 설정 (TASK 5-3)
#
# 정책은 2단계다.
#   1) 차단 검사 — E9, F63, F7, F82 (문법 오류·미정의 이름). 현재 0건이며 0건을 유지한다.
#   2) 스타일 래칫 — 나머지 전부. 지금 9304건이라 한 번에 고칠 수 없다.
#      총계가 `.flake8-baseline` 보다 **늘어나면 CI 가 실패**한다.
#      즉 기존 위반은 용인하되 **새 위반은 막는다.**
#
# 기존 9326건의 대량 정리는 하지 않았다. 해당 코드의 분기 커버리지가 2% 라
# (TASK 5-4) 테스트 없이 손대면 회귀를 잡을 방법이 없다. WS-5-7 이후에 한다.

[flake8]
max-line-length = 127
max-complexity = 10
