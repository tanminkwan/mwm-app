# Base Image
# 태그는 정확한 패치까지, digest 로 고정한다 (WS-2-5). 갱신은 Dependabot docker PR 로만 — 3.12 안의 패치만 연다
FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

# Set working directory
WORKDIR /app

# Install supervisor
RUN apt-get update && apt-get install -y supervisor

# Copy necessary files
COPY requirements.txt requirements.txt

# Install dependencies
# 빌드 도구 자체의 취약점도 막는다 (pip·setuptools·wheel, pip-audit 기준)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install redis

# The base image does not define a CMD or ENTRYPOINT
# It will be defined in the final image Dockerfile
