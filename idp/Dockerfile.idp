FROM python:3.12.4-slim-bookworm

WORKDIR /workspace

COPY requirements.txt requirements.txt
# 빌드 도구 자체의 취약점도 막는다 (pip·setuptools·wheel, pip-audit 기준 — 본 앱 Dockerfile.base 와 같다)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir -r requirements.txt

# app 패키지를 /workspace/app/ 로 복사
# tests/ 는 싣지 않는다 — 테스트는 Dockerfile.test 이미지에 마운트해서 돌린다
COPY app/ /workspace/app/

# PYTHONPATH에 workspace 추가하여 `from app import ...` 가능하게
ENV PYTHONPATH=/workspace

EXPOSE 5000

CMD ["gunicorn", "-b", "0.0.0.0:5000", "-w", "1", "app.run:app"]
